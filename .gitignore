# ==============================================================================
# DATASET & DỮ LIỆU NẶNG (TUYỆT ĐỐI KHÔNG PUSH LÊN GITHUB)
# ==============================================================================
# Bỏ qua toàn bộ các thư mục chứa dataset
dataset/
datasets/
data/
*/dataset/
*/datasets/
*/data/

# Bỏ qua các định dạng file dữ liệu đo đạc lớn
*.csv
*.tsv
*.npy
*.npz
*.h5
*.hdf5
*.mat
*.parquet
*.feather
*.pkl
*.pickle
*.dat
*.raw
*.bin

# Bỏ qua các thư mục mã nguồn mở tham khảo đã clone về (nặng hàng trăm MB)
reference_repos/
*/reference_repos/

# ==============================================================================
# MÔ HÌNH AI & CHECKPOINTS LỚN
# ==============================================================================
# File mô hình Keras / PyTorch / ONNX lớn (chỉ giữ file C++ Header .h)
*.keras
*.onnx
*.pt
*.pth
*.ckpt
checkpoints/
*/checkpoints/

# Ngoại lệ: Cho phép push các file TinyML C Header nhẹ (< 100KB) phục vụ firmware
!*.h
!*.hpp

# ==============================================================================
# TÀI LIỆU NỘI BỘ & QUẢN LÝ NHÓM
# ==============================================================================
Script/
Pref/
*.docx
~$*.docx
*.pdf
*cac_phuong_an_thiet_ke_semg.md

